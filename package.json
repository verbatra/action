    "docs:usage": "node generate-usage.mjs",
    "docs:usage:check": "node generate-usage.mjs --check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.2",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
